# Copy this file to secrets.yaml and fill in your own values. It is used by
# your own configuration (see esb-p1-reader.secure.example.yaml).
# secrets.yaml is listed in .gitignore. Never commit it.

wifi_ssid: "your-wifi-name"
wifi_password: "your-wifi-password"

# Password for the setup hotspot the device opens when it cannot join Wi-Fi.
# At least 8 characters.
ap_password: "choose-a-password"

# 32-byte base64 key that encrypts both the Home Assistant API connection and
# over-the-air firmware updates. Generate your own with:
#   openssl rand -base64 32
# Do not reuse a key copied from a guide or from this file.
api_encryption_key: "REPLACE_WITH_YOUR_OWN_KEY"
